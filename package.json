{
  "name": "bulls-and-cows",
  "version": "1.0.0",
  "description": "Bulls and Cows game in TypeScript - functional core, TDD",
  "main": "index.js",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc && node scripts/copy-public.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YaroslavaGD/bulls-and-cows.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/YaroslavaGD/bulls-and-cows/issues"
  },
  "homepage": "https://github.com/YaroslavaGD/bulls-and-cows#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
